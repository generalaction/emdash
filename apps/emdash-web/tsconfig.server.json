{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "electron-vite/node", "vite/client"],
    "paths": {
      "@core/*": ["../emdash-desktop/src/core/*"],
      "@main/*": ["../emdash-desktop/src/main/*"],
      "@root/*": ["../emdash-desktop/*"],
      "@web/*": ["./web/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "web/overrides/**/*.tsx",
    "../emdash-desktop/src/renderer/globals.d.ts"
  ]
}
