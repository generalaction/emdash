    "db:generate:file-search": "drizzle-kit generate --config drizzle-file-search.config.ts && tsx scripts/bundle-drizzle-migrations.ts src/runtimes/file-search/node/storage/migrations",
    "db:generate:workspace-registry": "drizzle-kit generate --config drizzle-workspace-registry.config.ts && tsx scripts/bundle-drizzle-migrations.ts src/runtimes/workspace-registry/node/persistence/migrations"
