{
  "name": "@emdash/ui",
  "version": "1.0.0",
  "description": "Shared UI components and styling interfaces for Emdash",
  "license": "Apache-2.0",
  "author": {
    "name": "Emdash Contributors",
    "email": "support@emdash.sh"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./react/primitives": {
      "types": "./dist/src/react/primitives/index.d.ts",
      "default": "./dist/react/primitives.js"
    },
    "./react/theme-runtime": {
      "types": "./dist/src/react/theme-runtime.d.ts",
      "default": "./dist/react/theme-runtime.js"
    },
    "./react/components": {
      "types": "./dist/src/react/components/index.d.ts",
      "default": "./dist/react/components.js"
    },
    "./react/patterns": {
      "types": "./dist/src/react/patterns/index.d.ts",
      "default": "./dist/react/patterns.js"
    },
    "./react/form": {
      "types": "./dist/src/react/patterns/form/index.d.ts",
      "default": "./dist/react/form.js"
    },
    "./react/chat-ui": {
      "types": "./dist/src/react/chat-ui/index.d.ts",
      "default": "./dist/react/chat-ui.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles": {
      "types": "./dist/src/styles/index.d.ts",
      "default": "./dist/styles.js"
    },
    "./styles/host": {
      "types": "./dist/src/styles/host.d.ts",
      "default": "./dist/styles/host.js"
    },
    "./styles/recipes/control": {
      "types": "./dist/src/styles/recipes/control.d.ts",
      "default": "./dist/styles/recipes/control.js"
    },
    "./styles/recipes/field-control": {
      "types": "./dist/src/styles/recipes/field-control.d.ts",
      "default": "./dist/styles/recipes/field-control.js"
    },
    "./styles/recipes/surface": {
      "types": "./dist/src/styles/recipes/surface.d.ts",
      "default": "./dist/styles/recipes/surface.js"
    },
    "./styles/recipes/menu-item": {
      "types": "./dist/src/styles/recipes/menu-item.d.ts",
      "default": "./dist/styles/recipes/menu-item.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch scripts/build-library.ts",
    "build": "tsx scripts/build-library.ts && pnpm run build:css",
    "build:css": "tsx scripts/build-styles.ts",
    "test": "vitest run",
    "build:theme": "pnpm --filter @emdash/theme run build:theme",
    "watch:theme": "pnpm --filter @emdash/theme run watch:theme",
    "storybook": "node ../../tooling/scripts/ensure-packages-built.mjs && storybook dev -p 6006 -c .storybook",
    "build:storybook": "storybook build -c .storybook",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@emdash/chat-ui": "workspace:*",
    "@emdash/shared": "workspace:*",
    "@emdash/theme": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@shikijs/langs": "^4.2.0",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-mention": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "@vanilla-extract/css": "^1.20.1",
    "beautiful-mermaid": "^1.1.3",
    "date-fns": "^4.1.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.564.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.3",
    "react-zoom-pan-pinch": "^4.0.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tanstack/react-form": "^1.28.4",
    "@tanstack/react-virtual": "^3.14.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.42",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "devicon": "^2.17.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.62.5",
    "storybook": "^10.4.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vite": "^7.1.11",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.28.4",
    "@tanstack/react-virtual": "^3.14.2",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "packageManager": "pnpm@10.28.2",
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  }
}
