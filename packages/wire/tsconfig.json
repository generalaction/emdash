{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@emdash/wire/rpc": ["./src/rpc/index.ts"],
      "@emdash/wire/live": ["./src/live/index.ts"],
      "@emdash/wire/state": ["./src/state/index.ts"],
      "@emdash/wire/mobx": ["./src/live/mobx/index.ts"],
      "@emdash/wire/testing": ["./src/testing/index.ts"],
      "@emdash/wire/worker": ["./src/worker/index.ts"],
      "@emdash/wire/worker/node": ["./src/worker/node/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
