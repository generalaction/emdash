{
  "hostEntrypoints": {
    "active": true,
    "entries": [
      {
        "name": "desktop",
        "entry": "apps/emdash-desktop/src/renderer/styles.css",
        "hostStylesheet": "./index.css"
      },
      {
        "name": "desktop-browser-tests",
        "entry": "apps/emdash-desktop/tooling/vitest/setup-browser-styles.ts",
        "hostStylesheet": "@renderer/index.css"
      },
      {
        "name": "ui-storybook",
        "entry": "packages/ui/.storybook/preview.tsx",
        "hostStylesheet": "./host.css"
      }
    ]
  },
  "cssCompatibilityRemoval": {
    "active": true,
    "packageJson": "packages/ui/package.json",
    "canonicalExport": "./styles.css",
    "canonicalTarget": "./dist/styles.css",
    "forbiddenFiles": [
      "packages/ui/vite.lib.config.ts",
      "packages/theme/src/__generated__/semantic.css",
      "packages/theme/src/__generated__/theme.css",
      "packages/theme/src/core/codegen/emit-semantic-css.ts",
      "packages/theme/src/core/codegen/emit-theme-css.ts",
      "packages/ui/src/react/chat-ui/chat-theme.css",
      "packages/ui/src/react/components/chat-composer/composer-contract.css.ts",
      "packages/ui/src/react/primitives/theme-provider.tsx",
      "packages/ui/src/styles/global.css.ts",
      "packages/ui/src/styles/layers.css.ts",
      "packages/ui/src/styles/tokens.css"
    ],
    "scanRoots": [
      "apps/emdash-desktop/src",
      "apps/emdash-desktop/tooling",
      "packages/ui/.storybook",
      "packages/ui/src"
    ],
    "retiredSpecifiers": [
      "@emdash/theme/semantic.css",
      "@emdash/theme/theme.css",
      "@emdash/ui/react/chat-ui/chat-theme.css",
      "@emdash/ui/style.css",
      "@emdash/ui/styles/base.css",
      "@emdash/ui/styles/effects.css",
      "@emdash/ui/styles/global",
      "@emdash/ui/styles/global-base.css",
      "@emdash/ui/styles/overflow-fade.css",
      "@emdash/ui/styles/tokens.css",
      "@emdash/ui/styles/typography.css"
    ]
  },
  "profileParity": {
    "active": true,
    "bootstrapManifest": "tooling/styling-convergence/manifests/bootstrap-profile-classes.json",
    "providerManifest": "tooling/styling-convergence/manifests/provider-profile-classes.json"
  },
  "integrationManifestCoverage": {
    "active": true,
    "manifests": [
      {
        "name": "Monaco",
        "path": "tooling/styling-convergence/manifests/monaco-integration.json"
      },
      {
        "name": "Xterm",
        "path": "tooling/styling-convergence/manifests/xterm-integration.json"
      }
    ]
  },
  "themeProductPathRemoval": {
    "active": true,
    "tokenManifest": "tooling/styling-convergence/manifests/theme-token-paths.json",
    "forbiddenPaths": [
      "foreground.conflict",
      "foreground.diffAdded",
      "foreground.diffDeleted",
      "foreground.diffModified",
      "foreground.merged",
      "workflow.cancelled",
      "workflow.done",
      "workflow.inProgress",
      "workflow.inReview",
      "workflow.todo"
    ]
  },
  "tailwindAliasConvergence": {
    "active": true,
    "stylesheet": "apps/emdash-desktop/src/core/primitives/styling/browser/tailwind-color-targets.css"
  }
}
